# Container Service Configuration

# Required for persistent JWT authentication.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-hex-character-secret
JWT_EXPIRY=24h

# Required only when bootstrapping the default admin user.
# Use a unique password of at least 12 characters, then remove it from the
# runtime environment after the admin account has been created and verified.
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Service ports
PORT=3000
HTTP_PORT=80
HTTPS_PORT=3443

# Server configuration
SERVER_HOST=localhost
BIND_ADDRESS=127.0.0.1

# Container limits
MAX_CONTAINERS_PER_USER=5
DEFAULT_CONTAINER_TTL=3600
CLEANUP_INTERVAL=300000

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Backend type (lxd or docker)
BACKEND_TYPE=lxd

# WebSocket configuration
WS_PATH=/terminal
